import { useEffect, useRef, useState } from 'react'
import type { AccessibilityConfig } from './types'

type Language = AccessibilityConfig['language']

const languageCodes: Record<Language, string> = {
  english: 'en-IN',
  hindi: 'hi-IN',
  marathi: 'mr-IN',
}

